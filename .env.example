# Copy to .env for local development. On Vercel, set these in Project → Settings → Environment Variables.

# Required
MONGODB_URI=mongodb+srv://USER:PASSWORD@cluster0.xxxxx.mongodb.net/creative-studio?retryWrites=true&w=majority
JWT_SECRET=change-me-to-a-long-random-string-of-at-least-32-characters
# One-time key to create the first admin from the web page (or run npm run create-admin instead). Remove after setup.
SETUP_KEY=
APP_URL=http://localhost:5173

# Sign in with Google (optional). Create an OAuth client ID (Web) in Google Cloud Console and add APP_URL as an authorised JavaScript origin.
GOOGLE_CLIENT_ID=
# Google accounts on these domains may sign in when invited, comma-separated (optional, e.g. yourcompany.com)
GOOGLE_ALLOWED_DOMAINS=

# Uploaded creatives: private Vercel Blob store. On Vercel, connecting the store sets this up automatically (OIDC).
# For local development, copy the store's read-write token:
BLOB_READ_WRITE_TOKEN=

# AI reading (strongly recommended)
ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=claude-sonnet-5-5

# Results from Realty Funnel Desk (optional)
PERF_SOURCE_URL=
PERF_API_TOKEN=

# Voiceover transcription, OpenAI-compatible (optional)
TRANSCRIBE_API_KEY=
