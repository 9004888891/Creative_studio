{
  "name": "creative-studio",
  "version": "1.0.0",
  "private": true,
  "description": "Creative Studio: real-estate creative analysis, checks and recommendations. MERN app (MongoDB, Express, React, Node) for Vercel.",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "dev:api": "node --watch server/local.js",
    "dev:web": "vite --config client/vite.config.js",
    "build": "vite build --config client/vite.config.js",
    "start": "node server/local.js",
    "test": "node --test --test-concurrency=1 tests/*.test.js",
    "create-admin": "node scripts/create-admin.mjs",
    "import-library": "node scripts/import-library.mjs"
  },
  "dependencies": {
    "@vercel/blob": "^2.3.0",
    "bcryptjs": "^3.0.2",
    "cookie-parser": "^1.4.7",
    "express": "^5.1.0",
    "google-auth-library": "^10.5.0",
    "helmet": "^8.1.0",
    "jsonwebtoken": "^9.0.2",
    "mongoose": "^8.17.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^5.0.0",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "react-router-dom": "^7.8.0",
    "supertest": "^7.1.4",
    "vite": "^7.1.2"
  },
  "overrides": {
    "zod": "$zod"
  }
}
